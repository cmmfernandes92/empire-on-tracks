<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.EditMapController"
      spacing="10"
      alignment="CENTER_LEFT">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <Label text="Edit Existing Map" style="-fx-font-weight: bold;" />

    <Label text="Select a map to edit:" />
    <ListView fx:id="mapListView" prefHeight="150" />

    <HBox spacing="10">
        <Button text="Edit Selected Map" onAction="#onEditSelected"/>
        <Button text="Cancel" onAction="#onCancel"/>
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: green;" wrapText="true"/>
</VBox>
