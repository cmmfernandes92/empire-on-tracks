<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.EditorMenuController"
      alignment="CENTER"
      spacing="10"
      style="-fx-padding: 30;">

    <Label text="--- EDITOR MENU ---" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Button fx:id="createMapButton"
            text="UC1: Create a New Map"
            onAction="#handleCreateNewMap"/>

    <Button text="Edit Existing Map"
            onAction="#handleEditExistingMap"/>

    <Button fx:id="switchToPlayerButton"
            text="Switch to Player Menu"
            onAction="#handleSwitchToPlayerMenu"/>

    <Button text="Cancel"
            onAction="#handleCancel"/>
</VBox>
