<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.AddIndustryFormController"
      spacing="14" alignment="TOP_LEFT">

    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

    <Label text="Add Industry"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <!-- Template list -->
    <TableView fx:id="templateTable" prefHeight="240">
        <columns>
            <TableColumn fx:id="colIdx"   text="#"     prefWidth="40"/>
            <TableColumn fx:id="colName"  text="Name"  prefWidth="140"/>
            <TableColumn fx:id="colCons"  text="Consumes"  prefWidth="120"/>
            <TableColumn fx:id="colProd"  text="Produces"  prefWidth="120"/>
        </columns>
    </TableView>

    <!-- coordinates -->
    <HBox spacing="10">
        <Label text="X:"/>
        <TextField fx:id="xField" prefWidth="60"/>
        <Label text="Y:"/>
        <TextField fx:id="yField" prefWidth="60"/>
    </HBox>

    <Label fx:id="msgLabel" style="-fx-text-fill: red;"/>

    <!-- buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancel" onAction="#onCancel"/>
        <Button text="Add Industry" onAction="#onAdd"/>
    </HBox>
</VBox>