<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ipp.isep.dei.ui.gui.SelectMaptoPlayController"
      spacing="15" alignment="TOP_CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Select a Map to Simulate"
           style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <ListView fx:id="mapListView" prefWidth="300" prefHeight="200" />

    <HBox spacing="20">
        <Button text="Start Simulation" onAction="#handleStart" />
        <Button text="Cancel" onAction="#handleCancel" />
    </HBox>

</VBox>