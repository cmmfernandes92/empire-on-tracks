<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.BuildLineFormController"
      spacing="10" alignment="CENTER" style="-fx-padding: 22;">

    <Label text="UC8 – Build a Railway Line"
           style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <HBox spacing="6" alignment="CENTER">
        <Label text="First station:"/>
        <ComboBox fx:id="firstStationComboBox" prefWidth="260"/>
    </HBox>

    <HBox spacing="6" alignment="CENTER">
        <Label text="Second station:"/>
        <ComboBox fx:id="secondStationComboBox" prefWidth="260"/>
    </HBox>

    <CheckBox fx:id="electrifiedCheckBox" text="Electrified"/>
    <CheckBox fx:id="doubleTrackCheckBox" text="Double track"/>

    <Label fx:id="budgetLabel" style="-fx-font-weight: bold;"/>

    <HBox spacing="12" alignment="CENTER">
        <Button text="Create Line" onAction="#handleCreate"/>
        <Button text="Cancel"      onAction="#handleCancel"/>
    </HBox>
</VBox>
