<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.UpgradeStationFormController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20;">

    <Label text="Upgrade a Station" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <HBox spacing="5" alignment="CENTER">
        <Label text="Select Station:" />
        <ComboBox fx:id="stationComboBox" prefWidth="300" />
    </HBox>

    <HBox spacing="5" alignment="CENTER">
        <Label text="Upgrade Type:" />
        <ComboBox fx:id="upgradeComboBox" prefWidth="200" />
    </HBox>

    <Label fx:id="stationNameLabel" text="Station: ---" style="-fx-font-style: italic;" />


    <Label fx:id="budgetLabel" text="Budget: $0.00" style="-fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="Apply Upgrade" onAction="#handleApplyUpgrade" />
        <Button text="Back" onAction="#handleBack" />
    </HBox>

</VBox>
