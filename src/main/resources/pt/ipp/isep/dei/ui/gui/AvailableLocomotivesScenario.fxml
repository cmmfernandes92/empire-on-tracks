<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ipp.isep.dei.javafxproj.AvailableLocomotivesController"
      alignment="TOP_CENTER" spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="------ Available Locomotives ------"
           style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Label text="Mode:" />
        <RadioButton fx:id="addRadio" text="Add" />
        <RadioButton fx:id="removeRadio" text="Remove" />
    </HBox>

    <ListView fx:id="locListView" prefHeight="200" prefWidth="300" />

    <Label text="Select a locomotive from the list above." />

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="confirmBtn" text="Confirm" onAction="#handleConfirm" />
        <Button fx:id="backBtn" text="Back" onAction="#handleBack" />
    </HBox>

</VBox>