<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.RegisterMenuController"
      alignment="CENTER" spacing="10" style="-fx-padding: 30;">
    <Label text="--- AUTH MENU: Register ---" style="-fx-font-size: 16px;"/>

    <Label text="Username:"/>
    <TextField fx:id="usernameField" promptText="Enter username"/>

    <Label text="Password:"/>
    <PasswordField fx:id="passwordField" promptText="Enter password"/>

    <Button fx:id="registerButton" text="Register" onAction="#handleRegister"/>
    <Label fx:id="errorLabel"
           wrapText="true"
           maxWidth="400"
           style="-fx-text-fill: red;" />
    <Label fx:id="statusLabel" text="" style="-fx-text-fill: green;"/>
</VBox>
