<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ipp.isep.dei.ui.gui.PlayerMenuController"
      spacing="20" alignment="TOP_CENTER">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="--- PLAYER MENU ---"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Button text="1 - Select a Map and Start Simulation"
            onAction="#handleStartSimulation"
            prefWidth="260"/>

    <Button text="2 - Load Saved Simulation"
            onAction="#handleLoadSimulation"
            prefWidth="260"/>

    <Button text="3 - Switch to Editor Menu"
            onAction="#handleSwitchToEditor"
            prefWidth="260"/>

    <Button text="0 - Cancel"
            onAction="#handleCancel"
            prefWidth="260"/>
</VBox>