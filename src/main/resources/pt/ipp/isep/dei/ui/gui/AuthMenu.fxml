<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ipp.isep.dei.ui.gui.AuthMenuController"
      alignment="CENTER" spacing="10" style="-fx-padding: 30;">
    <Label text="--- AUTH MENU ---" style="-fx-font-size: 16px;"/>

    <Button fx:id="registerButton" text="Register" onAction="#handleRegister"/>
    <Button fx:id="loginButton" text="Login" onAction="#handleLogin"/>
</VBox>
